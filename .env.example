# --- WhatsApp Cloud API (Meta) ---------------------------------------------------------------
# permanent/system-user access token. Blank = DRY-RUN (replies are logged, not sent)
WA_TOKEN=
# the sending number's id from the WhatsApp > API Setup page
WA_PHONE_NUMBER_ID=
# App settings > Basic > App secret. Used to check X-Hub-Signature-256
WA_APP_SECRET=
# any string; paste the same one into the webhook config in Meta
WA_VERIFY_TOKEN=
# local testing only: accept unsigned webhook POSTs
# ALLOW_UNSIGNED=1
PORT=3000

# --- Gemini ------------------------------------------------------------------------------------
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# --- Google service account (Calendar + Sheets) -------------------------------------------------
# path to the JSON key, kept OUTSIDE this repo
GOOGLE_SERVICE_ACCOUNT_FILE=
# or the raw JSON on one line
# GOOGLE_SERVICE_ACCOUNT_JSON=

# --- Who can use it -------------------------------------------------------------------------------
# your WhatsApp number, country code first (e.g. 15550100001)
ASSISTANT_OWNER_NUMBER=
# YOUR calendar (shared with the service account). Used for the owner only
ASSISTANT_CALENDAR_ID=
# IANA zone, e.g. Asia/Jakarta, Asia/Hong_Kong, Europe/London
ASSISTANT_TZ=UTC
# Teammates. Each one only drives the calendar in their own entry; no calendarId = DRY-RUN calendar.
TEAM={}
# TEAM={"15550100002":{"name":"Bob","role":"sales"},"15550100003":{"name":"Carol","calendarId":"carol@example.com","tz":"Europe/London"}}
# Which modes a role may use. No role = all modes. A role missing from here = no modes.
ROLES={"sales":["sales"]}

# --- Sales sheet ---------------------------------------------------------------------------------
# from the sheet URL; share the sheet with the service account (Editor)
SALES_SHEET_ID=
# default: the first tab
# SALES_SHEET_TAB=Leads
# SALES_STATUSES=No reply,Rejected,Consult,On hold,Won
# SALES_CHANNELS=WhatsApp,Phone call,Walk-in,IG DM,Referral,Email

# DB_PATH=data/assistant.db
